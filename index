<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SYSART | Архитектурное освещение</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --glow-color: rgba(255, 200, 100, 0.4);
            --bg-color: #070707;
        }
        
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-color);
            color: #ffffff;
            overflow-x: hidden;
        }

        /* Hero Background with Parallax effect */
        .hero-bg {
            background-image: linear-gradient(rgba(7, 7, 7, 0.3), rgba(7, 7, 7, 1)), url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        /* Premium Glow Effect on Hover */
        .project-card {
            transition: all 0.4s ease-in-out;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
            background: #111;
        }

        .project-card:hover {
            border-color: rgba(255, 200, 100, 0.3);
            box-shadow: 0 0 30px var(--glow-color);
            transform: translateY(-5px);
        }

        .project-image {
            transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            object-fit: cover;
        }

        .project-card:hover .project-image {
            transform: scale(1.08);
        }

        /* Smooth reveal animation */
        .reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: all 0.8s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #070707; 
        }
        ::-webkit-scrollbar-thumb {
            background: #333; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #555; 
        }
    </style>
</head>
<body class="antialiased selection:bg-yellow-600 selection:text-white">

    <!-- Navigation -->
    <nav class="fixed w-full z-50 transition-all duration-300 backdrop-blur-md bg-black/50 border-b border-white/5 py-4" id="navbar">
        <div class="max-w-7xl mx-auto px-6 md:px-12 flex justify-between items-center">
            <a href="#" class="flex items-center">
                <img src="Свежий лого белый.png" alt="Система Арт Логотип" style="max-height: 60px; object-fit: contain;">
            </a>
            <div class="hidden md:flex gap-8 text-sm font-medium tracking-wider text-gray-300">
                <a href="#static" class="hover:text-yellow-400 transition-colors">Статические</a>
                <a href="#dynamic" class="hover:text-yellow-400 transition-colors">Управляемые</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero-bg relative h-screen flex flex-col justify-center items-center text-center px-4">
        <div class="z-10 reveal active">
            <h1 class="text-6xl md:text-8xl lg:text-9xl font-extrabold tracking-tighter mb-4">SYSART</h1>
            <p class="text-xl md:text-2xl lg:text-3xl font-light tracking-widest text-gray-300 uppercase">Архитектурное освещение</p>
            <div class="mt-12">
                <a href="#static" class="inline-block border border-white/30 px-8 py-3 rounded-full uppercase tracking-wider text-sm hover:bg-white hover:text-black transition-all duration-300">
                    Смотреть проекты
                </a>
            </div>
        </div>
        <!-- Scroll indicator -->
        <div class="absolute bottom-10 animate-bounce">
            <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </div>
    </header>

    <!-- Static Projects Section -->
    <section id="static" class="py-24 px-6 md:px-12 max-w-screen-2xl mx-auto">
        <div class="mb-16 reveal">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">Статические <span class="text-yellow-500 font-light">Проекты</span></h2>
            <div class="h-px w-24 bg-yellow-500"></div>
            <p class="mt-4 text-gray-400 font-light max-w-2xl">Элегантность форм, подчеркнутая безупречным статичным светом. Проекты, создающие неповторимый ночной облик зданий.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Project Item 1 -->
            <div class="project-card rounded-xl group relative h-96 reveal cursor-pointer">
                <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=2069&auto=format&fit=crop" alt="Проект 1" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-xl font-semibold">ЖК "Авангард"</h3>
                    <p class="text-sm text-gray-300 font-light">Фасадное освещение</p>
                </div>
            </div>
            <!-- Project Item 2 -->
            <div class="project-card rounded-xl group relative h-96 reveal cursor-pointer" style="transition-delay: 100ms;">
                <img src="https://images.unsplash.com/photo-1574046419747-97598687799a?q=80&w=2070&auto=format&fit=crop" alt="Проект 2" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-xl font-semibold">Бизнес Центр Neva</h3>
                    <p class="text-sm text-gray-300 font-light">Контурная подсветка</p>
                </div>
            </div>
            <!-- Project Item 3 -->
            <div class="project-card rounded-xl group relative h-96 reveal cursor-pointer" style="transition-delay: 200ms;">
                <img src="https://images.unsplash.com/photo-1555597408-26bc8e548a46?q=80&w=2103&auto=format&fit=crop" alt="Проект 3" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-xl font-semibold">Отель Резиденция</h3>
                    <p class="text-sm text-gray-300 font-light">Локальная подсветка колонн</p>
                </div>
            </div>
            <!-- Project Item 4 -->
            <div class="project-card rounded-xl group relative h-96 md:col-span-2 reveal cursor-pointer">
                <img src="https://images.unsplash.com/photo-1496350352277-22f3fa14f6b5?q=80&w=2070&auto=format&fit=crop" alt="Проект 4" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-xl font-semibold">Мост Миллениум</h3>
                    <p class="text-sm text-gray-300 font-light">Заливающее освещение</p>
                </div>
            </div>
            <!-- Project Item 5 -->
            <div class="project-card rounded-xl group relative h-96 reveal cursor-pointer">
                <img src="https://images.unsplash.com/photo-1481026469463-66327c86e544?q=80&w=1908&auto=format&fit=crop" alt="Проект 5" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-xl font-semibold">Частная Вилла</h3>
                    <p class="text-sm text-gray-300 font-light">Ландшафтный и фасадный свет</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Dynamic Projects Section -->
    <section id="dynamic" class="py-24 px-6 md:px-12 max-w-screen-2xl mx-auto bg-black/40">
        <div class="mb-16 reveal">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">Управляемые <span class="text-yellow-500 font-light">Проекты</span></h2>
            <div class="h-px w-24 bg-yellow-500"></div>
            <p class="mt-4 text-gray-400 font-light max-w-2xl">Динамика, цвет и программируемые сценарии. Медиафасады и интерактивное освещение, оживляющее архитектуру.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Dyn Project 1 -->
            <div class="project-card rounded-xl group relative h-80 lg:col-span-2 reveal cursor-pointer">
                <img src="https://images.unsplash.com/photo-1542461141-86a076785055?q=80&w=1974&auto=format&fit=crop" alt="Динамика 1" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-indigo-900/80 via-black/30 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-xl font-semibold">Арена Центр</h3>
                    <p class="text-sm text-gray-300 font-light">RGBW Медиафасад</p>
                </div>
            </div>
            <!-- Dyn Project 2 -->
            <div class="project-card rounded-xl group relative h-80 reveal cursor-pointer" style="transition-delay: 100ms;">
                <img src="https://images.unsplash.com/photo-1563242023-4903330cb977?q=80&w=1974&auto=format&fit=crop" alt="Динамика 2" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-purple-900/80 via-black/30 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-xl font-semibold">Sky Tower</h3>
                    <p class="text-sm text-gray-300 font-light">Пиксельная подсветка DMX</p>
                </div>
            </div>
             <!-- Dyn Project 3 -->
             <div class="project-card rounded-xl group relative h-80 reveal cursor-pointer" style="transition-delay: 200ms;">
                <img src="https://images.unsplash.com/photo-1506544777-64cfbea11c47?q=80&w=2070&auto=format&fit=crop" alt="Динамика 3" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-pink-900/80 via-black/30 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-xl font-semibold">Арт-Объект "Куб"</h3>
                    <p class="text-sm text-gray-300 font-light">Интерактивный свет</p>
                </div>
            </div>
             <!-- Dyn Project 4 -->
             <div class="project-card rounded-xl group relative h-80 lg:col-span-4 reveal cursor-pointer">
                <img src="https://images.unsplash.com/photo-1550503195-2983713028cd?q=80&w=2070&auto=format&fit=crop" alt="Динамика 4" class="project-image w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-6 opacity-80 group-hover:opacity-100 transition-opacity">
                    <h3 class="text-2xl font-semibold">Набережная Технопарка</h3>
                    <p class="text-md text-gray-300 font-light">Комплексное сценарное освещение парка</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/10 py-12 text-center text-gray-500 font-light text-sm bg-[#050505]">
        <div class="mb-4 flex justify-center">
            <a href="#">
                <img src="Свежий лого белый.png" alt="Система Арт Логотип" style="max-height: 50px; object-fit: contain;">
            </a>
        </div>
        <p>Архитектурное освещение © 2026. Все права защищены.</p>
        <p class="mt-2 text-xs">Портфолио проектов</p>
    </footer>

    <!-- Scripts for animations -->
    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 50) {
                nav.classList.add('shadow-lg');
                nav.classList.replace('py-4', 'py-2');
            } else {
                nav.classList.remove('shadow-lg');
                nav.classList.replace('py-2', 'py-4');
            }
        });

        // Intersection Observer for scroll animations (fade in / slide up)
        const revealElements = document.querySelectorAll('.reveal');

        const revealCallback = (entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target); // Stop observing once revealed
                }
            });
        };

        const revealOptions = {
            threshold: 0.15, // Trigger when 15% of the element is visible
            rootMargin: "0px 0px -50px 0px"
        };

        const revealObserver = new IntersectionObserver(revealCallback, revealOptions);

        revealElements.forEach(el => {
            // Hero section is active by default
            if(!el.classList.contains('active')){
                revealObserver.observe(el);
            }
        });
    </script>
</body>
</html>
